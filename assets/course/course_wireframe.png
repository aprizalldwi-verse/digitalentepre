<svg xmlns="http://www.w3.org/2000/svg" width="800" height="450" viewBox="0 0 800 450">
    <defs>
        <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FF7262;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#0ACF83;stop-opacity:1" />
        </linearGradient>
    </defs>
    <rect width="800" height="450" rx="16" fill="url(#grad)"/>
    <circle cx="700" cy="100" r="200" fill="rgba(255,255,255,0.08)"/>
    <circle cx="150" cy="400" r="150" fill="rgba(255,255,255,0.05)"/>
    <text x="400" y="175" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white">Wireframe &amp;</text><text x="400" y="225" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white">Prototyping</text>
    <text x="400" y="285" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="rgba(255,255,255,0.8)">UI/UX Prototyping</text>
    <text x="400" y="420" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="rgba(255,255,255,0.5)">BelajarYuk</text>
