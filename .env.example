# ============================================
# BELAJARYUK - Environment Configuration
# ============================================
# Salin file ini menjadi .env dan isi dengan data kamu.
# Jangan commit file .env ke repository!
#
# Caranya:
#   cp .env.example .env
#   Isi nilai-nilai di bawah sesuai server kamu.
# ============================================

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_belajaryuk

# --- Midtrans (Payment Gateway) ---
# Dapatkan key di https://dashboard.midtrans.com/
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxx

# --- App Environment ---
APP_ENV=production
APP_URL=http://localhost/project-digital-entrepreneurship-fixed
